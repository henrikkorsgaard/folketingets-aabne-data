{{define "sagstrin"}}
{{/* TODO: Implement language localization over the date string. Alternative, is to just keep it as a string and format it. */}}   
{{/* TODO: Refactor sagstrin to have its own timeline and detail view. Figure out what happens when you replace container */}}

{{ $afstemningsId := 0 }}   
    
    <div class="timeline">

    {{- $odd := false}}
    {{ range $index, $el := . }}
        {{ $classlist := "sagstrin" }}
        {{/* see: https://stackoverflow.com/a/72465098 */}}
        {{ $odd = not $odd }}
        {{if $odd}} 
            {{ $classlist = print $classlist " left"}}
        {{else}}
            {{ $classlist = print $classlist " right"}}
        {{end}}


        {{/* TODO Change the functionality to point to the last item */}}
        {{ if .HasAfstemning }}
            {{ $afstemningsId = .Id }}
            {{ $classlist = print $classlist " afstemning"}}
        {{ end }}

        <div class="{{ $classlist }}" style="--index:{{ len (printf "a%*s" $index "") }};" hx-get="/sagstrin/{{ .Id }}" hx-trigger="click" hx-target=".details">   
            <b>{{.Sagstrinstype.Type}}</b><p>{{.Dato.Format "02-01-2006" }}</p>
        </div>
        <div class="dot" style="--index:{{ len (printf "a%*s" $index "") }};"></div>
    {{end}}
   
   </div>
   <!-- hx get the first one on load -->
   <div class="details card"  hx-get="/sagstrin/{{ $afstemningsId }}" hx-trigger="load" >
        <h1>Sagstrin details</h1>
   </div>
{{end}}

{{ define "sagstrin-details" }}
    <script>
        console.log({{.}})
    </script>
    <h1>{{.Titel }}</h1>
    <p>did it change</p>
{{ end }}