{{define "sagstrin"}}
    
    {{range .}}
        <div class="sagstrin">
            
            <div class="dot"></div>
            
            <div class="line"></div>
            <div class="content">
                <b>{{.Dato.Format "01-01-2006" }}</b>
                <p>{{.Titel}}</p>
                {{/* TODO: Implement language localization over the date string. Alternative, is to just keep it as a string and format it. */}}
            </div>
        </div>
    {{end}}
{{end}} 